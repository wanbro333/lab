# Copy to .env. setup.ps1 generates local random secrets automatically.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
MYSQL_DATABASE=lab_dev
MYSQL_USER=lab_app
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
